{
  "name": "nami-sh",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs && node scripts/test-generator.mjs",
    "pdf": "node scripts/generate-pdf.mjs",
    "pdf:verify": "node scripts/verify-pdf.mjs",
    "check": "npm test && npm run build && npm run pdf && npm run pdf:verify"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "unpdf": "^1.6.2",
    "vite": "^8.1.6"
  }
}
